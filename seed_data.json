    "model": "users.tutorialstep",
    "pk": 1,
    "fields": {
      "image": null,
      "title": "Welcome to Progress RPG",
      "body": "If your brain makes starting feel impossible, you're in the right place.\r\n\r\nThis isn't about being productive. It's about making one small move — and letting the rest follow.\r\n\r\nProgress RPG gives your brain something to anchor to. A timer that holds your focus. A gentle presence that says someone knows you're working — even when no one else is around.\r\n\r\nEvery minute you spend on something real becomes XP and levels. Small efforts add up. Progress is progress, however it looks.",
      "order": 1,
      "youtube_url": ""
    }
  },
  {
    "model": "users.tutorialstep",
    "pk": 2,
    "fields": {
      "image": null,
      "title": "It's all about you",
      "body": "As you log activity, you earn XP and level up. Keep returning to build steady progress.",
      "order": 2,
      "youtube_url": ""
    }
  },
  {
    "model": "users.tutorialstep",
    "pk": 3,
    "fields": {
      "image": null,
      "title": "Start a focus session",
      "body": "Choose what you want to work on, start the timer, and stay with it. Completed focus time becomes activity that earns XP.",
      "order": 3,
      "youtube_url": ""
    }
  },
  {
    "model": "users.tutorialstep",
    "pk": 4,
    "fields": {
      "image": null,
      "title": "Recent activities",
      "body": "Your completed sessions appear in recent activity. You can hover over individual activities and click the 'play' button to repeat them.",
      "order": 4,
      "youtube_url": ""
    }
  },
